@model List<Agendamento.Models.Paciente>
@{
    ViewData["Title"] = "Pacientes";
}
<h1>Pacientes</h1>
<p><a asp-action="Inserir" class="btn btn-success btn-lg mb-4">Inserir</a></p>
<div class="col-md-12">
    <table class="table align-middle table-striped table-hover">
        <thead><tr><th>Id</th><th>Nome</th><th>CPF</th><th>Telefone</th><th>Data de Nascimento</th><th>Ações</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td><td>@p.Nome</td><td>@p.Cpf</td><td>@p.Telefone</td><td>@p.DataNascimento.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Detalhar" asp-route-id="@p.Id" class="btn btn-outline-warning">Detalhar</a>
                    <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-outline-info">Editar</a>
                    <a asp-action="Remover" asp-route-id="@p.Id" class="btn btn-outline-danger">Remover</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
