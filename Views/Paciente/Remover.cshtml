@model Agendamento.Models.Paciente
@{ ViewData["Title"] = "Remover Paciente"; }
<h1>Remover</h1><h4>Tem certeza que deseja remover este paciente?</h4><hr />
<dl class="row">
<dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd>
<dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@Model.Cpf</dd>
<dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@Model.Telefone</dd>
<dt class="col-sm-3">Endereço</dt><dd class="col-sm-9">@Model.Endereco</dd>
<dt class="col-sm-3">Data de Nascimento</dt><dd class="col-sm-9">@Model.DataNascimento.ToString("dd/MM/yyyy")</dd>
</dl>
<form asp-action="Remover">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Remover" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
