@model Agendamento.Models.Paciente
@{ ViewData["Title"] = "Inserir Paciente"; }
<h4>Paciente</h4><hr />
<div class="row"><div class="col-md-5">
<form asp-action="Inserir">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Cpf"></label><input asp-for="Cpf" class="form-control" /><span asp-validation-for="Cpf" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Telefone"></label><input asp-for="Telefone" class="form-control" /><span asp-validation-for="Telefone" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Endereco"></label><input asp-for="Endereco" class="form-control" /><span asp-validation-for="Endereco" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="DataNascimento"></label><input asp-for="DataNascimento" class="form-control" /><span asp-validation-for="DataNascimento" class="text-danger"></span></div>
    <input type="submit" value="Inserir" class="btn btn-outline-success" />
    <a asp-action="Index" class="btn btn-outline-info">Voltar</a>
</form>
</div></div>
