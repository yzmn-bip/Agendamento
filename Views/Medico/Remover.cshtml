@model Agendamento.Models.Medico
@{ ViewData["Title"] = "Remover Médico"; }
<h1>Remover</h1><h4>Tem certeza que deseja remover este médico?</h4><hr />
<dl class="row">
<dt class="col-sm-2">Nome</dt><dd class="col-sm-10">@Model.Nome</dd>
<dt class="col-sm-2">CRM</dt><dd class="col-sm-10">@Model.Crm</dd>
<dt class="col-sm-2">Especialidade</dt><dd class="col-sm-10">@Model.Especialidade</dd>
</dl>
<form asp-action="Remover">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Remover" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
