@model Agendamento.Models.Medico
@{ ViewData["Title"] = "Editar Médico"; }
<h4>Editar Médico</h4><hr />
<div class="row"><div class="col-md-4">
<form asp-action="Editar">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Crm"></label><input asp-for="Crm" class="form-control" /><span asp-validation-for="Crm" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Especialidade"></label><input asp-for="Especialidade" class="form-control" /><span asp-validation-for="Especialidade" class="text-danger"></span></div>
    <input type="submit" value="Salvar" class="btn btn-outline-success" />
    <a asp-action="Index" class="btn btn-outline-info">Voltar</a>
</form>
</div></div>
